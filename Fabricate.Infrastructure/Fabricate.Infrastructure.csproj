<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Fabricate.Application\Fabricate.Application.csproj" />
    <ProjectReference Include="..\Fabricate.Domain\Fabricate.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The emulator suite (#91) seeds DynamoDB and Cosmos through the same connection-string parsers the adapters
       use, so the format is exercised on the way in as well as on the way out. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Fabricate.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.103.5" />
    <!-- #76: envelope-encrypts the Data Protection key ring, so the ring can live in the application database
         without a dump of that database decrypting every tenant secret. -->
    <PackageReference Include="AWSSDK.KeyManagementService" Version="4.0.3" />
    <!-- S3-compatible artifact storage (#84): AWS S3, MinIO, Cloudflare R2 and Backblaze B2 all speak this API. -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.6.6" />
    <!-- Native object storage for the other two clouds (#90). S3 covers AWS, MinIO, R2 and B2; these two speak
         their own APIs, and on Azure and GCP the native store is the one with ambient identity already in place. -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.1" />
    <PackageReference Include="Azure.Identity" Version="1.17.0" />
    <PackageReference Include="Google.Cloud.Storage.V1" Version="4.10.0" />
    <!-- Official Anthropic .NET SDK plus its cloud-platform clients. Anthropic.Bedrock requires AWSSDK.Core 4.x,
         which is why AWSSDK.DynamoDBv2 above sits on the 4.x line. -->
    <PackageReference Include="Anthropic" Version="12.45.0" />
    <PackageReference Include="Anthropic.Bedrock" Version="0.13.1" />
    <PackageReference Include="Anthropic.Vertex" Version="0.5.3" />
    <PackageReference Include="Anthropic.Foundry" Version="0.7.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="9.0.10" />
    <!-- #76: the key ring in the application database, so every instance shares one and a replaced machine does
         not take the ability to decrypt stored credentials with it. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="9.0.10" />
    <!-- GHSA-23rf-6693-g89p et al: DataProtection 9.0.10 pulls System.Security.Cryptography.Xml 9.0.10; pin past the advisories.
         10.0.11 then drew GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj and GHSA-r955-8q5j-3h83 (Xml) and GHSA-2fmv-rv2c-59x7 and
         GHSA-846f-f764-76mx (Pkcs, which Xml pulls in), so both are pinned to the current servicing release. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="Google.Cloud.Firestore" Version="3.8.0" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.47.0" />
    <!-- SQLitePCLRaw GHSA-2m69-gcr7-jv3q: bundled SQLite is vulnerable at <= 2.1.11.
         Microsoft.Data.Sqlite 9.0.10 pulls 2.1.10 transitively, so pin the bundle forward
         to the first unaffected release. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.10" />
    <PackageReference Include="MongoDB.Driver" Version="3.4.0" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Parquet.Net" Version="6.0.3" />
  </ItemGroup>

</Project>
